# Wikiplast Data Collector - Environment Variables Configuration Template
# Copy this file to .env and fill in your actual values
# NEVER commit the .env file to version control!

# ==============================================================================
# Database Configuration (for wikiplast_scraper.py)
# ==============================================================================

# Option 1: Individual components (recommended)
DB_SERVER=your_sql_server_hostname
DB_NAME=your_database_name
DB_USER=your_username
DB_PASSWORD=your_secure_password
DB_DRIVER=ODBC Driver 17 for SQL Server
DB_PORT=1433

# Option 2: Windows Authentication (leave DB_USER and DB_PASSWORD empty)
# DB_TRUSTED_CONNECTION=yes

# Database Table Configuration
DB_TABLE_NAME=wikiplast_prices

# ==============================================================================
# Logging Configuration
# ==============================================================================

LOG_LEVEL=INFO
LOG_DIR=logs

# ==============================================================================
# Retry Configuration
# ==============================================================================

RETRY_MAX_ATTEMPTS=3
RETRY_WAIT_MULTIPLIER=1
RETRY_WAIT_MAX=10

# ==============================================================================
# Security Notes
# ==============================================================================
#
# 1. After copying to .env, replace all 'your_*' placeholders with actual values
# 2. Use strong passwords (minimum 12 characters, mixed case, numbers, symbols)
# 3. Never commit .env file to Git
# 4. For production, consider using Azure Key Vault or similar secret management
# 5. For Windows Authentication, set DB_TRUSTED_CONNECTION=yes and leave
#    DB_USER and DB_PASSWORD empty
#
